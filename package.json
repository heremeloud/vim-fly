{
  "name": "vimmy-fly",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check:i18n": "node --experimental-strip-types --no-warnings scripts/check-i18n.mjs",
    "check:links": "node --experimental-strip-types --no-warnings scripts/check-links.mjs",
    "emoji": "node --experimental-strip-types --no-warnings scripts/copy-emoji.mjs"
  },
  "dependencies": {
    "@fontsource/noto-sans-thai": "^5.3.0",
    "@fontsource/sacramento": "^5.3.0",
    "@fontsource/sniglet": "^5.3.0",
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "emoji-datasource-google": "^16.0.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.5"
  }
}
